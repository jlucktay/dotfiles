{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/link-worktree-memory.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/git/github.com/s0xDk/ghostty-blackhole/claude-token.py"
          },
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/git/github.com/s0xDk/ghostty-blackhole/claude-token.py"
          },
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/git/github.com/s0xDk/ghostty-blackhole/claude-token.py"
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ovo-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "ovotech/ovo-claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Learning",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}/git/*",
        "git/*"
      ],
      "allowRead": [
        "{{ .chezmoi.homeDir }}/git"
      ]
    }
  },
  "feedbackDrafts": "notify",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Tossing word salad"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.280",
  "timeFormat": "24-hour",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false
}
