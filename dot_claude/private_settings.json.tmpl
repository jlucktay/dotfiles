{{- $ovo := eq (printf "%.4s" .chezmoi.hostname | lower) "ovo-" -}}
{
  {{ if $ovo -}}
  "env": {
    "OTEL_METRICS_INCLUDE_REPOSITORY": "true",
    "OTEL_RESOURCE_INCLUDE_HOST": "1"
  },
  {{ end -}}
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    {{ if $ovo -}}
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    {{ end -}}
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/ghostty-blackhole/claude-token.py"
          {{ if $ovo -}}
          },
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          {{ end -}}
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/ghostty-blackhole/claude-token.py"
          {{ if $ovo -}}
          },
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          {{ end -}}
          }
        ]
      }
    {{ if $ovo -}}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": [
              "hook",
              "claude",
              "--hook-input",
              "stdin"
            ],
            "timeout": 10
          }
        ]
      }
    {{ end -}}
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.local/share/ghostty-blackhole/claude-token.py"
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true
  },
  "outputStyle": "Learning",
  "feedbackDrafts": "notify",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Tossing word salad"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.280",
  "timeFormat": "24-hour",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false
}
