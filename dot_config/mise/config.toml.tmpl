[tools]
# Latest version
"aqua:BurntSushi/ripgrep" = "latest"
"aqua:cargo-bins/cargo-binstall" = "latest"
"aqua:charmbracelet/gum" = "latest"
"aqua:FiloSottile/age" = "latest"
"aqua:golangci/golangci-lint" = "latest"
"aqua:google/yamlfmt" = "latest"
{{ if ne .profile "ovo" -}}
"aqua:helm/helm" = "latest"
{{ end -}}
"aqua:jj-vcs/jj" = "latest"
"aqua:jqlang/jq" = "latest"
"aqua:kubecolor/kubecolor" = "latest"
"aqua:kubernetes-sigs/kind" = "latest"
"aqua:kubernetes-sigs/krew" = "latest"
{{ if ne .profile "ovo" -}}
"aqua:kubernetes/kubernetes/kubectl" = "latest"
{{ end -}}
"aqua:mikefarah/yq" = "latest"
"aqua:pnpm/pnpm" = "latest"
"aqua:pre-commit/pre-commit" = "latest"
"aqua:rclone/rclone" = "latest"
"aqua:sunny0826/kubecm" = "latest"
"github:go-task/task" = "latest"
"github:jlucktay/my-github-repos" = "latest"
"github:slsa-framework/slsa-verifier" = "latest"
"github:twpayne/chezmoi" = "latest"
"pipx:yamllint" = "latest"
pipx = "latest"
uv = "latest"

{{ if eq .profile "ovo" -}}
# Latest version for OVO
"aqua:argoproj/argo-cd" = "latest"
"aqua:cert-manager/cmctl" = "latest"
"aqua:derailed/k9s" = "latest"
"aqua:git-lfs/git-lfs" = "latest"
"aqua:GoogleContainerTools/skaffold" = "latest"
"aqua:hashicorp/terraform" = "latest"
"aqua:kubernetes-sigs/kustomize" = "latest"
"aqua:npryce/adr-tools" = "latest"
"aqua:terraform-docs/terraform-docs" = "latest"
{{ end -}}

# Prevent AWS CLI's 'python' from leaking
# https://github.com/jdx/mise/pull/7076
"aqua:aws/aws-cli" = { version = "latest", symlink_bins = "true" }

# Pinned major version
"node" = "24"
{{ if eq .profile "ovo" -}}
"aqua:helm/helm" = "3"
{{ end -}}

{{ if eq .profile "ovo" -}}
# Pinned minor version for OVO
"aqua:kubernetes/kubernetes/kubectl" = "1.35"
{{ end -}}

{{ if eq .profile "ovo" -}}
# Pinned patch version for OVO
"aqua:kyverno/kyverno" = "1.18.1"
"aqua:norwoodj/helm-docs" = "1.14.2"
{{ end -}}

[settings]
# Pushes tools' bin-paths to the front of PATH instead of allowing modifications of PATH after activation to take precedence.
activate_aggressive = true

# Stick to the one Homebrew toolchain.
disable_tools = ["go"]

# Don't bother with '.terraform-version' files and the like.
idiomatic_version_file_enable_tools = []

# Filter tool versions by release date to limit supply chain risk.
minimum_release_age = "7d"

# Look after yourself.
self_update.auto = true
self_update.check_duration = "3d"
self_update.minimum_release_age = "3d"

[settings.status]
missing_tools = "always"
show_env = true
show_tools = true
